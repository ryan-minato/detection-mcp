{
	"name": "Ubuntu",
	"image": "mcr.microsoft.com/devcontainers/base:jammy",
	"features": {
		"ghcr.io/devcontainers/features/common-utils:2": {
      "configureZshAsDefaultShell": true
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
		"ghcr.io/devcontainers/features/git:1": {},
		"ghcr.io/devcontainers/features/git-lfs:1": {},
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/stacit-ai/devcontainer-features/uv:1": {
			"toolsToInstall": "pre-commit,rust-just"
		}
	},
	"postCreateCommand": "uv sync --locked --all-groups && uv run pre-commit install --install-hooks --hook-type pre-commit --hook-type commit-msg --hook-type pre-push",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-containers",
        "editorconfig.editorconfig",
        "ms-python.python",
        "tamasfe.even-better-toml",
        "davidanson.vscode-markdownlint"
      ]
    }
  }
}
