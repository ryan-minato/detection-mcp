# EditorConfig helps maintain consistent coding styles
# for multiple developers working on the same project.
# https://editorconfig.org/
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

# Python
[*.py]
indent_style = space
indent_size = 4

# Configuration / data files
[*.{json,jsonc,yaml,yml}]
indent_style = space
indent_size = 2

[*.{toml,ini,cfg,conf}]
indent_style = space
indent_size = 4

# pyproject.toml
[pyproject.toml]
indent_style = space
indent_size = 4

# just command runner
[justfile]
indent_style = space
indent_size = 4

# Markdown: trailing spaces can represent hard line breaks
[*.md]
trim_trailing_whitespace = false

# Lock files: preserve generated content, revoke inherited rules
[*.lock]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

# LICENSE: preserve content exactly, revoke inherited rules
[LICENSE]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
